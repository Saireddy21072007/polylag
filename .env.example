# Copy to .env and fill in. .env is gitignored -- keep it that way.
#
# PAPER AND WATCH MODES NEED NONE OF THIS. Only fill it in when you have
# decided to trade live.
#
# The private key below controls real funds. Anyone who reads this file can
# drain the account. Use a wallet that holds ONLY your trading bankroll --
# never your main wallet.

# Private key (hex, with or without 0x) of the wallet that signs orders.
POLYMARKET_PRIVATE_KEY=

# The address that actually holds the USDC. For a Polymarket web account this
# is your proxy/funder address, NOT the signer address. Copy it from the
# deposit screen.
POLYMARKET_FUNDER_ADDRESS=

# Signature type:
#   0 = EOA signing for itself
#   1 = email/magic proxy wallet   (most Polymarket web accounts)
#   2 = browser-wallet proxy
POLYMARKET_SIGNATURE_TYPE=1

# Optional: API creds. Leave blank and the client derives them from the key.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=
